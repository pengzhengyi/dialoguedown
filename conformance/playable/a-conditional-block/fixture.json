{
  "$schema": "https://pengzhengyi.github.io/dialoguedown/schema/fixture-0.schema.json",
  "name": "a block conditional takes the first branch whose condition holds",
  "playbook": "playbook.json",
  "because": "the branches are tried in the order written, so a satisfied first branch must be taken and the else never reached",
  "session": [
    {
      "expect": {
        "resolve": {
          "boolean": [
            "Alice.HasKey"
          ]
        }
      }
    },
    {
      "send": {
        "supply": {
          "Alice.HasKey": true
        }
      }
    },
    {
      "expect": {
        "said": {
          "speaker": "Alice",
          "speech": "The key turns."
        }
      }
    },
    {
      "send": "next"
    },
    {
      "expect": {
        "ended": {}
      }
    }
  ]
}
