{
  "$schema": "https://pengzhengyi.github.io/dialoguedown/schema/fixture-0.schema.json",
  "name": "a failed effect holds the run, and the retry carries on",
  "playbook": "playbook.json",
  "because": "the world did not change, so the run cannot read on -- a port that skipped the effect, or that let `next` past it after a failure, would tell a different story than the one written; the retry landing proves the position held",
  "session": [
    {
      "expect": {
        "perform": {
          "kind": "default-command",
          "action": "fade in"
        }
      }
    },
    {
      "send": {
        "failed": "the database refused"
      }
    },
    {
      "send": "next"
    },
    {
      "expect": {
        "refused": {
          "reason": "misplaced"
        }
      }
    },
    {
      "send": "done"
    },
    {
      "expect": {
        "said": {
          "speaker": "Alice",
          "speech": "Hello."
        }
      }
    },
    {
      "send": "next"
    },
    {
      "expect": {
        "ended": {}
      }
    }
  ]
}
