{
  "$schema": "https://pengzhengyi.github.io/dialoguedown/schema/fixture-0.schema.json",
  "name": "a menu asks for its conditions as truths and its labels' queries as words, in one request",
  "playbook": "playbook.json",
  "because": "each key is named under the kind of answer it needs, so a driver knows what to answer with, and each kind keeps the order written, which is what lets two ports send the same request; an unavailable option's label is filled too, because the host decides how to show it",
  "session": [
    {
      "expect": {
        "said": {
          "speaker": "Alice",
          "speech": "What now?"
        }
      }
    },
    {
      "send": "next"
    },
    {
      "expect": {
        "resolve": {
          "boolean": [
            "Hero.HasSword",
            "Hero.HasShield"
          ],
          "text": [
            "WeaponName",
            "ShieldName"
          ]
        }
      }
    },
    {
      "send": {
        "supply": {
          "Hero.HasSword": true,
          "Hero.HasShield": false,
          "WeaponName": "the old sword",
          "ShieldName": "Aegis"
        }
      }
    },
    {
      "expect": {
        "offer": {
          "ordered": false,
          "options": [
            {
              "label": "Draw the old sword",
              "available": true
            },
            {
              "label": "Raise Aegis",
              "available": false
            }
          ]
        }
      }
    },
    {
      "send": {
        "choose": 0
      }
    },
    {
      "expect": {
        "resolve": {
          "text": [
            "WeaponName"
          ]
        }
      }
    },
    {
      "send": {
        "supply": {
          "WeaponName": "the old sword"
        }
      }
    },
    {
      "expect": {
        "said": {
          "speech": "Draw the old sword"
        }
      }
    },
    {
      "send": "next"
    },
    {
      "expect": {
        "said": {
          "speaker": "Alice",
          "speech": "Steady."
        }
      }
    },
    {
      "send": "next"
    },
    {
      "expect": {
        "ended": {}
      }
    }
  ]
}
