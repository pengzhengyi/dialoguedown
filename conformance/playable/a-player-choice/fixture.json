{
  "$schema": "https://pengzhengyi.github.io/dialoguedown/schema/fixture-0.schema.json",
  "name": "a menu is offered, and taking an option leads into that arm",
  "playbook": "playbook.json",
  "because": "the arms converge afterwards, so the only thing that can distinguish them is the line the chosen arm speaks",
  "session": [
    { "expect": { "said": { "speaker": "Alice", "speech": "Which way?" } } },
    { "send": "continue" },
    { "expect": { "asked": [
        { "label": "Go east", "available": true },
        { "label": "Go west", "available": true }
      ] } },
    { "send": { "choose": 0 } },
    { "expect": { "said": { "speech": "Go east" } } },
    { "send": "continue" },
    { "expect": { "said": { "speaker": "Alice", "speech": "Onward." } } },
    { "send": "continue" },
    { "expect": { "ended": {} } }
  ]
}
