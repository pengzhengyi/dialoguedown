<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DialogueDown.ConfigurationLoader</RootNamespace>
    <AssemblyName>DialogueDown.ConfigurationLoader</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <!-- Reads a project's dialogue.toml into a CompilerOptions with Tomlyn, so the
         engine-agnostic core never takes a TOML dependency. -->
    <Description>Loads a DialogueDown dialogue.toml project configuration into CompilerOptions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DialogueDown.ConfigurationLoader.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DialogueDown\DialogueDown.csproj" />
  </ItemGroup>

  <!-- Public API surface tracking. This library ships to consumers, so a change to a
       public type must show up as a diff in PublicAPI.Unshipped.txt for review rather
       than in a consumer's build. RS0016/RS0017 fail the build when the files and the
       surface disagree. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
