<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DialogueDown.Play</RootNamespace>
    <AssemblyName>DialogueDown.Play</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- The terminal player's presentation. It renders the playbook's own speech records and
         writes through Spectre.Console, and it depends on neither the compiler nor the runner:
         the driver that connects it to a run is a later, separate piece. -->
    <Description>The terminal player's presentation: speech as markup, the choice menu, and the player's turns.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DialogueDown.Play.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DialogueDown.Playbook\DialogueDown.Playbook.csproj" />
  </ItemGroup>

</Project>
