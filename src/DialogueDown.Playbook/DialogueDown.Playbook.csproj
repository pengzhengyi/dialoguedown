<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DialogueDown.Playbook</RootNamespace>
    <AssemblyName>DialogueDown.Playbook</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <!-- The contract between a compiler and a runtime, so it belongs to neither and
         depends on nothing: a game embeds this and a runner, never the compiler. -->
    <Description>The portable playbook a DialogueDown compile emits, and the reader that loads one back.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DialogueDown.Playbook.Tests" />
  </ItemGroup>

  <!-- JsonStringEnumMemberName pins an enum's wire name against a C# rename. It is in-box from
       .NET 9, so only the net8.0 build needs the out-of-band package; the reference goes away with
       that target. See https://github.com/pengzhengyi/dialoguedown/issues/314. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
