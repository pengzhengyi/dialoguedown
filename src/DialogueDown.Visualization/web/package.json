{
  "name": "dialoguedown-visualization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client for the DialogueDown compilation-visualization report, bundled by Vite into a single self-contained HTML the .NET library embeds.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typescript/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:infra": "node --test e2e-live/*.test.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint:js": "eslint . --cache --cache-location .cache/eslint/",
    "lint:css": "stylelint \"src/**/*.css\" --cache --cache-location .cache/stylelint/",
    "format": "prettier --check . --cache --cache-location .cache/prettier/.prettier-cache",
    "check": "npm run typecheck && npm run lint:js && npm run lint:css && npm run format && npm run test && npm run test:infra",
    "build:cli": "dotnet build ../../DialogueDown.Cli/DialogueDown.Cli.csproj -c Release",
    "e2e:live": "npm run build:cli && playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/fira-code": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@picocss/pico": "^2.0.6",
    "@tanstack/table-core": "^9.3.1",
    "@vscode/codicons": "^0.0.46-24",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "dompurify": "^3.4.17",
    "github-slugger": "^2.0.0",
    "marked": "^18.1.1",
    "marked-gfm-heading-id": "^4.1.4",
    "mermaid": "^11.17.2",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.3.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
