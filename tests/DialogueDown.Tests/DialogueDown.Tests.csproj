<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shipped examples, so tests read them from the output rather than hunting for the
         checkout they were built from. -->
    <!-- The published schema, so a test can check the URL playbooks advertise is the one here. -->
    <None Include="..\..\schema\*.schema.json"
          Link="schema\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The playable conformance cases, so a test can recompile each source and check the
         committed playbook still matches it. -->
    <None Include="..\..\conformance\playable\**\*"
          Link="conformance\playable\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\examples\*.dialogue.md"
          Link="examples\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DialogueDown\DialogueDown.csproj" />
  </ItemGroup>

</Project>
